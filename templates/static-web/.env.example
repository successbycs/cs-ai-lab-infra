# Set a unique value for every product copy, e.g. customer-demo-web.
# COMPOSE_PROJECT_NAME=
WEB_IMAGE=nginx:1.27-alpine
WEB_CPU_LIMIT=0.25
WEB_MEMORY_LIMIT=128M
WEB_PIDS_LIMIT=64
# Set only with compose.private-ingress.yaml; defaults to loopback, never 0.0.0.0.
STATIC_WEB_BIND_ADDRESS=127.0.0.1
STATIC_WEB_PORT=8088
