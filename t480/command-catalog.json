{
  "schema_version": "t480.operations.v1",
  "scope": "fixed_operations_only",
  "operations": [
    {
      "id": "health",
      "purpose": "Inspect the T480 Windows host identity and installed memory.",
      "approval_required": false,
      "execution": "adapter_owned"
    },
    {
      "id": "storage",
      "purpose": "Inspect Windows filesystem capacity and free space.",
      "approval_required": false,
      "execution": "adapter_owned"
    },
    {
      "id": "wsl_status",
      "purpose": "Inspect WSL status and installed distributions.",
      "approval_required": false,
      "execution": "adapter_owned"
    },
    {
      "id": "docker_status",
      "purpose": "Inspect Docker and Docker Compose availability in Ubuntu.",
      "approval_required": false,
      "execution": "adapter_owned"
    },
    {
      "id": "docker_preflight",
      "purpose": "Inspect potentially conflicting Docker and container-runtime packages in Ubuntu.",
      "approval_required": false,
      "execution": "adapter_owned"
    },
    {
      "id": "docker_install",
      "purpose": "Install Docker Engine and the Compose plugin in Ubuntu, then grant the fixed Ubuntu user Docker access.",
      "approval_required": true,
      "execution": "adapter_owned"
    }
  ],
  "prohibited": [
    "arbitrary_command_execution",
    "password_based_automation",
    "unapproved_installation",
    "unapproved_deletion",
    "unapproved_restart",
    "public_network_exposure"
  ]
}
