# Copy to plane/plane-access.local.env and chmod 600 it.
# This T16-local adapter setting is reusable by application repositories.
# Do not put a token here. Point to an existing owner-only token file instead.
PLANE_ORIGIN=http://replace-with-private-plane-host:8090
PLANE_WORKSPACE_SLUG=replace-with-workspace-slug
PLANE_API_KEY_FILE=/home/chris/.config/forex/plane-mcp.env
PLANE_API_KEY_VARIABLE=PLANE_API_KEY
