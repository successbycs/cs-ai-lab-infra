# Copy this file to .env and replace every placeholder before deploying.
POSTGRES_DB=cs_ai_lab
POSTGRES_USER=cs_ai_lab
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_UNIQUE_PASSWORD
# PostgreSQL is controller-only; do not make it reachable from the LAN.
POSTGRES_BIND_ADDRESS=127.0.0.1

# Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=CHANGE_ME_TO_A_LONG_RANDOM_VALUE

# Local-only defaults for the T480.
TZ=Pacific/Auckland
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_PORT=5678
N8N_BIND_ADDRESS=127.0.0.1
N8N_DIAGNOSTICS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false
N8N_RUNNERS_ENABLED=true

# Private-LAN, read-only operational dashboard. It contains no credentials,
# service logs, database records, or n8n workflow data.
HEALTH_DASHBOARD_BIND_ADDRESS=0.0.0.0
HEALTH_DASHBOARD_PORT=8080
