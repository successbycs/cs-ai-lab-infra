# Documentation template only. The live file is created with mode 0600 at
# /home/chris/.config/cs-ai-lab/penpot.env, never beside this Compose file.
PENPOT_DATABASE_PASSWORD=CHANGE_ME_TO_A_LONG_UNIQUE_PASSWORD
PENPOT_SECRET_KEY=CHANGE_ME_TO_A_512_BIT_RANDOM_VALUE
PENPOT_PUBLIC_URI=http://localhost:9001
PENPOT_BIND_ADDRESS=127.0.0.1
PENPOT_HTTP_PORT=9001
PENPOT_FLAGS=enable-login-with-password enable-prepl-server enable-mcp enable-access-tokens disable-registration disable-email-verification disable-secure-session-cookies
PENPOT_BACKUP_RETENTION_DAYS=14
TZ=Pacific/Auckland
